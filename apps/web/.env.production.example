# Copy these into Vercel → Project → Settings → Environment Variables

# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Stripe ──────────────────────────────────────────────────
# Switch to live keys for production: sk_live_... / pk_live_...
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Set in Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (Brevo SMTP) ──────────────────────────────────────
# Get SMTP key from: brevo.com → SMTP & API → SMTP
# Verify sender at: brevo.com → Senders & IPs → Senders
BREVO_SMTP_USER=berryvangrand@gmail.com
BREVO_SMTP_KEY=your-brevo-smtp-key
BREVO_FROM_EMAIL=berryvangrand@gmail.com

# ─── App ─────────────────────────────────────────────────────
# Must be your production domain (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
