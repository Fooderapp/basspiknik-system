# Copy these into Vercel → Project → Settings → Environment Variables

# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Stripe ──────────────────────────────────────────────────
# Switch to live keys for production: sk_live_... / pk_live_...
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Set in Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_...
# Verified sender address in Resend (e.g. tickets@yourdomain.com)
# If not set, falls back to onboarding@resend.dev (Resend sandbox — for testing only)
RESEND_FROM_EMAIL=tickets@yourdomain.com

# ─── App ─────────────────────────────────────────────────────
# Must be your production domain (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
