{
  "expo": {
    "name": "EventOS",
    "slug": "eventos-mobile",
    "version": "1.0.0",
    "scheme": "eventos",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eventos.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan QR codes for tickets and drink orders.",
        "NSMicrophoneUsageDescription": "The camera requires microphone access.",
        "NSLocationWhenInUseUsageDescription": "Your location is used by Stripe Terminal to prevent fraud during card payments.",
        "NSBluetoothAlwaysUsageDescription": "Required by Stripe Terminal SDK for connecting to card readers.",
        "NSBluetoothPeripheralUsageDescription": "Required by Stripe Terminal SDK for connecting to card readers.",
        "NSLocalNetworkUsageDescription": "Used to connect to Stripe Terminal card readers on the local network.",
        "NFCReaderUsageDescription": "Used by Stripe Terminal to accept contactless (Tap to Pay) card payments.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.proximity-reader.payment.acceptance": true,
        "com.apple.developer.applesignin": [
          "Default"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.eventos.mobile",
      "permissions": [
        "CAMERA",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "NFC",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan QR codes for tickets and drink orders."
        }
      ],
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": false,
          "locationWhenInUsePermission": "Your location is used by Stripe Terminal to prevent fraud during card payments."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.eventos.mobile",
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ddbfd710-d185-4a02-9b2c-52551edc2850"
      }
    },
    "owner": "basspiknik"
  }
}
