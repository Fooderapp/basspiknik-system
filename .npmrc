# NativeWind's babel preset sets jsxImportSource globally, so Metro injects
# `nativewind/jsx-runtime` imports into deep packages it transforms (e.g.
# @expo/log-box). Under pnpm's isolated store those packages can't resolve it,
# so hoist the runtime packages to the root node_modules.
public-hoist-pattern[]=nativewind
public-hoist-pattern[]=react-native-css-interop

confirm-modules-purge=false
